void setup() {
  size(1000, 650, P3D);
  surface.setLocation(50, 50);
  textFont(createFont("SansSerif", 14));
  sphereDetail(10);
  BG = color(12, 14, 24);

  // API key: environment variable ANTHROPIC_API_KEY, or the file data/apikey.txt
  String envKey = System.getenv("ANTHROPIC_API_KEY");
  if (envKey != null) apiKey = envKey.trim();
  File kf = new File(dataPath("apikey.txt"));
  if (kf.exists()) {
    String[] l = loadStrings(kf);
    if (l != null && l.length > 0) apiKey = trim(l[0]);
  }
  useAI = apiKey.length() > 0;

  // fallback categoriser (used when the AI is off or fails)
  keywords.put("Food",       new String[]{"pizza","cook","pasta","eat","food","cheese","recipe"});
  keywords.put("Study",      new String[]{"study","university","tu/e","design","learning","course","exam"});
  keywords.put("Tech",       new String[]{"esp32","oocsi","processing","code","arduino","project","ai"});
  keywords.put("Travel",     new String[]{"trip","flight","travel","copenhagen","hotel","vacation"});
  keywords.put("Hobbies",    new String[]{"guitar","music","jazz","game","play","running","sport"});
  keywords.put("Social",     new String[]{"scout","volunteer","friend","camp","family","team"});
  keywords.put("Chat style", new String[]{"prefers","answers","tone","chat","short"});

  // start-up demo memories: random age and importance so the visual meaning is visible
  for (int i = 0; i < 6; i++) {
    Memory m = addLocal(samples[i]);
    m.born = millis() - random(0, AGE_SPAN * 0.9);
    m.importance = 1 + (int) random(5);
  }
  //initialise cp5 sliders
  cp5 = new ControlP5(this);
  cp5.setAutoDraw(false);
  
  cp5.addSlider("redValue")
     .setPosition(780, 570)
     .setSize(180, 10)
     .setRange(0, 255)
     .setValue(255)
     .setLabel("R");
  
  cp5.addSlider("greenValue")
     .setPosition(780, 592)
     .setSize(180, 10)
     .setRange(0, 255)
     .setValue(255)
     .setLabel("G");
  
  cp5.addSlider("blueValue")
     .setPosition(780, 604)
     .setSize(180, 10)
     .setRange(0, 255)
     .setValue(255)
     .setLabel("B");
}

void controlEvent(ControlEvent event) {
  if (selMem == null) return;

  float r = cp5.getController("redValue").getValue();
  float g = cp5.getController("greenValue").getValue();
  float b = cp5.getController("blueValue").getValue();

  selMem.col = color(r, g, b);
}

void updateColorSliders() {
  float px = width - PANEL_W * panelAnim;
  float x = px + 22;
  
  //spawns RGB controls
  cp5.getController("redValue")
     .setPosition(x, 565);

  cp5.getController("greenValue")
     .setPosition(x, 587);

  cp5.getController("blueValue")
     .setPosition(x, 609);

  boolean visible = pMem != null && panelAnim > 0.95;

  cp5.getController("redValue").setVisible(visible);
  cp5.getController("greenValue").setVisible(visible);
  cp5.getController("blueValue").setVisible(visible);
}

void draw() {
  try {
    drawScene();
  } catch (Throwable t) {
    t.printStackTrace();
    noLoop();
  }
}

void drawScene() {
  background(BG);
  lights();

  // ---- results coming back from the AI thread ----
  Result r;
  while ((r = results.poll()) != null) {
    pending--;
    Memory nm;
    if (r.error == null) {
      nm = placeMemory(r.text, r.category, r.importance, r.reason, "AI");
      status = "";
    } else {
      nm = addLocal(r.text);
      status = "AI failed, used keywords instead (" + r.error + ")";
    }
    selectMemory(nm);
  }

  // ---- animation ----
  if (!mousePressed) rotY += (selMem != null || selCat != null) ? 0.0008 : 0.002;
  for (Category c : cats) c.update();
  for (Memory m : mems) m.update();

  if (selMem != null) tgtFocus.set(selMem.pos);
  else if (selCat != null) tgtFocus.set(selCat.pos);
  else tgtFocus.set(0, 0, 0);
  curFocus.lerp(tgtFocus, 0.08);
  zoom = lerp(zoom, tgtZoom, 0.08);

  boolean isOpen = (selMem != null || selCat != null);
  panelAnim = lerp(panelAnim, isOpen ? 1 : 0, 0.12);

  // ---- 3D scene ----
  pushMatrix();
  translate(width / 2 - panelAnim * PANEL_W / 2, height / 2, 0);
  scale(zoom);
  rotateX(rotX);
  rotateY(rotY);
  translate(-curFocus.x, -curFocus.y, -curFocus.z);

  strokeWeight(1.5);
  for (Category c : cats) {
    float v = catVis(c);
    stroke(red(c.col), green(c.col), blue(c.col), 120 * v);
    line(0, 0, 0, c.pos.x, c.pos.y, c.pos.z);
  }
  for (Memory m : mems) {
    float v = vis(m);
    strokeWeight(0.5 + m.importance * 0.4);       // thicker line = more important
    stroke(red(m.cat.col), green(m.cat.col), blue(m.cat.col), 110 * v);
    line(m.cat.pos.x, m.cat.pos.y, m.cat.pos.z, m.pos.x, m.pos.y, m.pos.z);
  }

  noStroke();
  fill(255, 240, 200);
  sphere(26);
  sx0 = screenX(0, 0, 0);
  sy0 = screenY(0, 0, 0);

  for (Category c : cats) {
    pushMatrix();
    translate(c.pos.x, c.pos.y, c.pos.z);
    fill(lerpColor(BG, c.col, catVis(c)));
    sphere(12 + c.count * 1.2);
    c.sx = screenX(0, 0, 0);
    c.sy = screenY(0, 0, 0);
    popMatrix();
  }

  for (Memory m : mems) {
    pushMatrix();
    translate(m.pos.x, m.pos.y, m.pos.z);
    color base = m.col;

    if (!m.interacted) {
      float blink = (sin(millis() * 0.006) + 1) / 2;
      base = lerpColor(m.col, color(255), blink);
    }
    
    if (m == selMem) base = color(255);
    fill(lerpColor(BG, base, vis(m)));
    sphere(m.radius() + (m == selMem ? 3 : 0));
    m.sx = screenX(0, 0, 0);
    m.sy = screenY(0, 0, 0);
    popMatrix();
  }
  popMatrix();

  // ---- 2D overlay ----
  hint(DISABLE_DEPTH_TEST);
  camera();
  noLights();
  textAlign(CENTER, CENTER);

  fill(255);
  textSize(15);
  text("AI MEMORY", sx0, sy0 - 40);

  // pulsing ring around the core while the AI is thinking
  if (pending > 0) {
    noFill();
    stroke(255, 220, 120, 200);
    strokeWeight(2);
    float d = 60 * zoom + 8 * sin(frameCount * 0.2);
    ellipse(sx0, sy0, d, d);
    noStroke();
  }

  for (Category c : cats) {
    fill(red(c.col), green(c.col), blue(c.col), 255 * catVis(c));
    textSize(c == selCat ? 18 : 16);
    text(c.name + " (" + c.count + ")", c.sx, c.sy - 28 * max(1, zoom * 0.8));
  }

  // halo around important memories (4 and 5)
  noFill();
  strokeWeight(1.5);
  for (Memory m : mems) {
    if (m.importance >= 4 && vis(m) > 0.4) {
      stroke(red(m.cat.col), green(m.cat.col), blue(m.cat.col), 90 + 50 * sin(frameCount * 0.08 + m.id));
      float d = m.radius() * 2 * zoom + 12 + (m.importance - 4) * 6;
      ellipse(m.sx, m.sy, d, d);
    }
  }
  noStroke();

  if (selCat != null) {
    textSize(12);
    for (Memory m : mems) {
      if (m.cat != selCat || m == selMem) continue;
      fill(255, 190);
      text(shorten(m.text, 150), m.sx, m.sy - 16 - m.radius() * zoom * 0.5);
    }
  }

  noFill();
  stroke(255, 200);
  strokeWeight(2);
  float ring = 6 * sin(frameCount * 0.12);
  if (selMem != null) {
    float d = (selMem.radius() + 3) * 2 * zoom + 18 + ring;
    ellipse(selMem.sx, selMem.sy, d, d);
  } else if (selCat != null) {
    float d = (24 + selCat.count * 2.4) * zoom + 16 + ring;
    ellipse(selCat.sx, selCat.sy, d, d);
  }
  noStroke();

  Object hov = (mouseX > width - PANEL_W * panelAnim) ? null : pick(mouseX, mouseY);
  cursor(hov != null ? HAND : ARROW);
  if (hov instanceof Memory && hov != selMem) {
    Memory hm = (Memory) hov;
    textAlign(CENTER, CENTER);
    textSize(14);
    float w = textWidth(hm.text) + 20;
    fill(0, 200);
    stroke(red(hm.cat.col), green(hm.cat.col), blue(hm.cat.col));
    rectMode(CENTER);
    rect(hm.sx, hm.sy - 30 - hm.radius(), w, 26, 6);
    noStroke();
    fill(255);
    text(hm.text, hm.sx, hm.sy - 31 - hm.radius());
    rectMode(CORNER);
  }

  // HUD
  textAlign(LEFT, TOP);
  textSize(13);
  fill(160);
  text("Drag = rotate | Scroll = zoom | Click = focus | ESC = overview | SPACE = sample | TAB = type | UP/DOWN = importance | A = AI on/off", 15, 12);
  text("Memories: " + mems.size() + "   Categories: " + cats.size(), 15, 32);
  if (pending > 0) {
    fill(255, 220, 120);
    text("AI is sorting " + pending + " memor" + (pending == 1 ? "y" : "ies") + "...", 15, 52);
  } else if (status.length() > 0) {
    fill(255, 140, 120);
    text(status, 15, 52);
  } else {
    fill(160);
    if (apiKey.length() == 0) text("Sorting: keywords (no API key found)", 15, 52);
    else text("Sorting: " + (useAI ? "AI (" + MODEL + ")" : "keywords"), 15, 52);
  }

  // legend
  fill(120);
  textSize(12);
  text("Dot size = importance (1-5)", 15, height - 95);
  text("Brightness = freshness (fades over 10 min)", 15, height - 79);
  text("Halo = important (4-5)", 15, height - 63);

  if (typing) {
    fill(255, 220, 120);
    textSize(16);
    text("New memory > " + input + ((frameCount / 20) % 2 == 0 ? "_" : ""), 15, height - 35);
  }

  drawPanel();
  
  updateColorSliders();
  cp5.draw();
  
  hint(ENABLE_DEPTH_TEST);
}

