// 3D AI Memory Map v3: Processing 3 / 4 (Java mode)
// Drag = rotate | Scroll = zoom | Click memory/category = focus | ESC = overview
// SPACE = add sample memory | TAB = type memory, ENTER to add
// UP / DOWN = change importance of the selected memory
// A = switch the AI categoriser on/off (keywords are used when it is off)

import java.util.*;
import java.io.*;
import java.net.*;
import java.util.concurrent.*;
import controlP5.*; //handles sliders and dropdowns
ControlP5 cp5; //global instance

// ---------- AI settings ----------
final String MODEL = "claude-haiku-5-5";   // change if you want another model
String apiKey = "";
boolean useAI = true;
volatile int pending = 0;                  // memories waiting for the AI
ConcurrentLinkedQueue<Result> results = new ConcurrentLinkedQueue<Result>();
String status = "";

final float AGE_SPAN = 10 * 60 * 1000;     // memories fade over 10 minutes (demo speed)

ArrayList<Category> cats = new ArrayList<Category>();
ArrayList<Memory> mems = new ArrayList<Memory>();
ArrayList<Btn> btns = new ArrayList<Btn>();
LinkedHashMap<String, String[]> keywords = new LinkedHashMap<String, String[]>();

float rotX = -0.3, rotY = 0;
float zoom = 1, tgtZoom = 1;
PVector curFocus = new PVector(0, 0, 0);
PVector tgtFocus = new PVector(0, 0, 0);

Memory selMem = null, pMem = null;
Category selCat = null, pCat = null;
float panelAnim = 0;
final float PANEL_W = 340;

boolean typing = false;
String input = "";
boolean editingMem = false;
String editInput = "";
float R1 = 260;
int memCounter = 0;
float pressX, pressY;
float sx0, sy0;
ArrayList<String> lastHits = new ArrayList<String>();
color BG;

String[] samples = {
  "Likes pizza with extra cheese", "Studies Industrial Design at TU/e",
  "Works on an ESP32 project with OOCSI", "Has a trip planned to Copenhagen",
  "Plays guitar on weekends", "Prefers short answers in chat",
  "Volunteers at a scouting camp", "Likes running in the morning",
  "Learning Processing for a university project", "Favourite music is lo-fi and jazz",
