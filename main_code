void memList(ArrayList<Memory> list, float x, float y, float w, int max, Memory current) {
  textSize(14);
  int shown = min(max, list.size());
  for (int i = 0; i < shown; i++) {
    Memory o = list.get(i);
    float ry = y + i * 30;
    boolean over = mouseX > x - 8 && mouseX < x + w + 8 && mouseY > ry - 4 && mouseY < ry + 24;
    if (o == current) fill(255, 255, 255, 40);
    else fill(255, 255, 255, over ? 30 : 10);
    rect(x - 8, ry - 4, w + 16, 28, 6);
    fill(o.cat.col);
    ellipse(x + 4, ry + 10, 4 + o.importance * 1.2, 4 + o.importance * 1.2);
    fill(o == current ? 255 : 210);
    text(shorten(o.text, w - 30), x + 18, ry + 2);
    btns.add(new Btn(x - 8, ry - 4, w + 16, 28, o, null));
  }
  if (list.size() > shown) {
    fill(130);
    text("+ " + (list.size() - shown) + " more", x, y + shown * 30 + 4);
  }
}

class Btn {
  float x, y, w, h;
  Memory mem;
  Category cat;
  String action = "";
  Btn(float x, float y, float w, float h, Memory mem, Category cat) {
    this.x = x; this.y = y; this.w = w; this.h = h;
    this.mem = mem; this.cat = cat;
  }
  
  //handles string cases for editable memories
  Btn(float x, float y, float w, float h, String action) {
    this.x = x; this.y = y; this.w = w; this.h = h;
    this.action = action;
  }
  
  boolean hit(float mx, float my) { return mx > x && mx < x + w && my > y && my < y + h; }
}

String shorten(String s, float maxW) {
  if (textWidth(s) <= maxW) return s;
  while (s.length() > 1 && textWidth(s + "...") > maxW) s = s.substring(0, s.length() - 1);
  return s + "...";
}

String ago(float born) {
  int s = (int) ((millis() - born) / 1000);
  if (s < 5) return "just now";
  if (s < 60) return s + " seconds ago";
  if (s < 3600) return (s / 60) + " min ago";
  return (s / 3600) + " h ago";
}

// ---------------- Visual meaning ----------------

float fresh(Memory m) { return 1 - constrain((millis() - m.born) / AGE_SPAN, 0, 1); }

float catVis(Category c) { return (selCat == null || c == selCat) ? 1 : 0.3; }

// visibility = focus dimming x freshness (old memories fade, never fully disappear)
float vis(Memory m) {
  if (m == selMem) return 1;
  float f = 0.3 + 0.7 * fresh(m);
  if (selCat == null) return f;
  if (m.cat == selCat) return f * (selMem == null ? 1 : 0.6);
  return f * 0.2;
}

// ---------------- Selection ----------------

void selectMemory(Memory m) {
  selMem = m;
  selCat = m.cat;
  m.interacted = true;
  tgtZoom = 2.4;
}

void selectCategory(Category c) {
  selCat = c;
  selMem = null;
  tgtZoom = 1.5;
}

void deselect() {
  selMem = null;
  selCat = null;
  tgtZoom = 1;
}

Object pick(float mx, float my) {
  Memory bm = null;
  float bd = 1e9;
  for (Memory m : mems) {
    float d = dist(mx, my, m.sx, m.sy);
    float hit = 8 + m.radius() * zoom;
    if (d < hit && d < bd) { bd = d; bm = m; }
  }
  if (bm != null) return bm;

  Category bc = null;
  bd = 1e9;
  for (Category c : cats) {
    float d = dist(mx, my, c.sx, c.sy);
    if (d < (12 + c.count * 1.2) * zoom + 6 && d < bd) { bd = d; bc = c; }
  }
  if (bc != null) return bc;

  if (dist(mx, my, sx0, sy0) < 26 * zoom + 8) return "core";
  return null;
}

// ---------------- Memory logic ----------------

// Entry point: send a new memory to the AI (or the keyword fallback)
void submitMemory(String text) {
  if (useAI) {
    pending++;
    status = "";
    new Thread(new AIJob(text, catNames())).start();
  } else {
    selectMemory(addLocal(text));
  }
}

String catNames() {
  if (cats.size() == 0) return "none yet";
  String s = "";
  for (int i = 0; i < cats.size(); i++) s += (i > 0 ? ", " : "") + cats.get(i).name;
  return s;
}

// keyword fallback
Memory addLocal(String text) {
  String catName = classify(text);
  String why = lastHits.size() > 0
    ? "Keywords matched: " + join(lastHits.toArray(new String[0]), ", ")
    : "No keyword matched, so it went to Other";
  return placeMemory(text, catName, 3, why, "keywords");
}

String classify(String text) {
  String t = text.toLowerCase();
  String bestCat = "Other";
  int bestScore = 0;
  lastHits = new ArrayList<String>();
  for (Map.Entry<String, String[]> e : keywords.entrySet()) {
    ArrayList<String> h = new ArrayList<String>();
    for (String k : e.getValue()) if (t.contains(k)) h.add(k);
    if (h.size() > bestScore) { bestScore = h.size(); bestCat = e.getKey(); lastHits = h; }
  }
  return bestCat;
}

Memory placeMemory(String text, String catName, int importance, String why, String source) {
  Category c = getOrCreateCategory(catName);
  c.count++;
  PVector dir = c.target.copy().normalize();
  dir.add(PVector.random3D().mult(0.9)).normalize();
  PVector offset = dir.mult(random(70, 140));
  Memory m = new Memory(text, c, offset, constrain(importance, 1, 5), why, source);
  mems.add(m);
  return m;
}

Category getOrCreateCategory(String name) {
  for (Category c : cats) if (c.name.equalsIgnoreCase(name)) return c;
  Category c = new Category(name);
  cats.add(c);
  relayout();
  return c;
}

void relayout() {
  int n = cats.size();
  for (int i = 0; i < n; i++) {
    float y = (n == 1) ? 0 : 1 - (i + 0.5) * 2.0 / n;
    float r = sqrt(max(0, 1 - y * y));
    float theta = i * 2.39996323;
    cats.get(i).target = new PVector(cos(theta) * r, y, sin(theta) * r).mult(R1);
  }
}

// ---------------- The real AI categoriser ----------------

class Result {
  String text, category, reason, error;
  int importance = 3;
}

class AIJob implements Runnable {
  String text, existing;
  AIJob(String text, String existing) { this.text = text; this.existing = existing; }

  public void run() {
    Result r = new Result();
    r.text = text;
    try {
      String system = "You organise the memories an AI assistant stores about a user. "
        + "Reply with ONLY a JSON object, no other text: "
        + "{\"category\": \"1-2 word category name\", \"importance\": 1-5, \"reason\": \"max 12 words\"}. "
        + "Reuse an existing category when it fits; only invent a new one if none fits. "
        + "Importance: 5 = core, long-term fact about the person, 3 = useful preference or habit, "
        + "1 = trivial or short-lived detail.";

      JSONObject body = new JSONObject();
      body.setString("model", MODEL);
      body.setInt("max_tokens", 200);
      body.setString("system", system);
      JSONArray msgs = new JSONArray();
      JSONObject um = new JSONObject();
      um.setString("role", "user");
      um.setString("content", "Existing categories: " + existing + "\nNew memory: " + text);
      msgs.append(um);
      body.setJSONArray("messages", msgs);

      URL url = new URL("https://api.anthropic.com/v1/messages");
      HttpURLConnection con = (HttpURLConnection) url.openConnection();
      con.setRequestMethod("POST");
      con.setConnectTimeout(8000);
      con.setReadTimeout(20000);
      con.setRequestProperty("content-type", "application/json");
      con.setRequestProperty("x-api-key", apiKey);
      con.setRequestProperty("anthropic-version", "2023-06-01");
      con.setDoOutput(true);
      OutputStream os = con.getOutputStream();
      os.write(body.toString().getBytes("UTF-8"));
      os.close();

      int code = con.getResponseCode();
      InputStream is = (code < 400) ? con.getInputStream() : con.getErrorStream();
      BufferedReader br = new BufferedReader(new InputStreamReader(is, "UTF-8"));
      StringBuilder sb = new StringBuilder();
      String line;
      while ((line = br.readLine()) != null) sb.append(line);
      br.close();
      String resp = sb.toString();
      if (code >= 400) {
        println("API error " + code + ": " + resp);
        throw new Exception("HTTP " + code);
      }

      JSONObject root = parseJSONObject(resp);
      String out = root.getJSONArray("content").getJSONObject(0).getString("text");
      int a = out.indexOf('{');
      int b = out.lastIndexOf('}');
      JSONObject j = parseJSONObject(out.substring(a, b + 1));
      r.category = cleanCat(j.getString("category"));
      r.importance = j.getInt("importance");
      r.reason = j.getString("reason");
    } catch (Exception e) {
      r.error = e.toString();
      println("AI categoriser failed: " + e);
    }
    results.add(r);
  }
}

String cleanCat(String s) {
  s = s.trim();
  if (s.length() == 0) return "Other";
  if (s.length() > 18) s = s.substring(0, 18).trim();
  return s.substring(0, 1).toUpperCase() + s.substring(1);
}

// ---------------- Classes ----------------

class Category {
  String name;
  PVector pos = new PVector(0, 0, 0);
  PVector target = new PVector(0, 0, 0);
  color col;
  int count = 0;
  float sx, sy;

  Category(String name) {
    this.name = name;
    pushStyle();
    colorMode(HSB, 360, 100, 100);
    col = color((cats.size() * 57 + 20) % 360, 60, 100);
    popStyle();
  }
  void update() { pos.lerp(target, 0.06); }
}

class Memory {
  int id;
  String text, why, source;
  Category cat;
  PVector offset;
  PVector pos = new PVector(0, 0, 0);
  int importance;
  float born = millis();
  float sx, sy;
  color col;
  boolean interacted = false;
  
  Memory(String text, Category cat, PVector offset, int importance, String why, String source) {
    this.id = ++memCounter;
    this.text = text;
    this.cat = cat;
    this.offset = offset;
    this.importance = importance;
    this.why = why;
    this.source = source;
    this.col = cat.col;
  }
  float radius() { return 3 + importance * 1.8; }
  void update() { pos.lerp(PVector.add(cat.pos, offset), 0.05); }
}

// ---------------- Input ----------------

void mousePressed() {
  pressX = mouseX;
  pressY = mouseY;
}

void mouseDragged() {
  if (mouseX > width - PANEL_W * panelAnim) return;
  rotY += (mouseX - pmouseX) * 0.01;
  rotX -= (mouseY - pmouseY) * 0.01;
}

void mouseReleased() {
  if (dist(mouseX, mouseY, pressX, pressY) > 5) return;

  for (Btn b : btns) {
    if (b.hit(mouseX, mouseY)) {
      if (b.action.equals("DELETE_BTN") && selMem != null) {
        deleteMemory(selMem);
        return;
      } else if (b.action.equals("EDIT_BTN") && selMem != null) {
        editingMem = !editingMem;
        if (editingMem) {
          editInput = selMem.text;
        } else {
          // Save changes made during edit
          selMem.text = editInput;
        }
        return;
      }
      
      if (b.mem != null) selectMemory(b.mem);
      else if (b.cat != null) selectCategory(b.cat);
      return;
    }
  }
  if (mouseX > width - PANEL_W * panelAnim) return;

  Object p = pick(mouseX, mouseY);
  if (p instanceof Memory) {
    editingMem = false; // reset edit mode when clicking a new memory
    selectMemory((Memory) p);
  } else if (p instanceof Category) {
    editingMem = false;
    selectCategory((Category) p);
  } else {
    editingMem = false;
    deselect();
  }
}

void mouseWheel(MouseEvent e) {
  tgtZoom *= (e.getCount() > 0) ? 0.93 : 1.07;
  tgtZoom = constrain(tgtZoom, 0.3, 4);
}

void keyPressed() {
  if (key == CODED) {
    if (selMem != null && !editingMem && keyCode == UP) selMem.importance = min(5, selMem.importance + 1);
    if (selMem != null && !editingMem && keyCode == DOWN) selMem.importance = max(1, selMem.importance - 1);
    return;
  }
  if (key == ESC) {
    key = 0;
    typing = false;
    editingMem = false;
    deselect();
    return;
  }
  
  // If we are actively editing an existing memory's text
  if (editingMem) {
    if (key == ENTER || key == RETURN) {
      if (editInput.trim().length() > 0) {
        selMem.text = editInput.trim();
      }
      editingMem = false;
    } else if (key == BACKSPACE) {
      if (editInput.length() > 0) editInput = editInput.substring(0, editInput.length() - 1);
    } else if (key >= 32) {
      editInput += key;
    }
    // Also visually mirror text changes live into the object while typing
    if (selMem != null && editInput.length() > 0) {
      selMem.text = editInput;
    }
    return;
  }

  if (key == TAB) { typing = !typing; input = ""; return; }

  if (typing) {
    if (key == ENTER || key == RETURN) {
      if (input.trim().length() > 0) submitMemory(input.trim());
      input = "";
      typing = false;
    } else if (key == BACKSPACE) {
      if (input.length() > 0) input = input.substring(0, input.length() - 1);
    } else if (key >= 32) {
      input += key;
    }
  } else if (key == ' ') {
    submitMemory(samples[(int) random(samples.length)]);
  } else if (key == 'a' || key == 'A') {
    if (apiKey.length() > 0) useAI = !useAI;
  }
}

//handles deleting memories
void deleteMemory(Memory m) {
  // Decrement category count
  m.cat.count--;
  
  // Remove from lists
  mems.remove(m);
  
  // Clean up category if it's now empty
  if (m.cat.count <= 0) {
    cats.remove(m.cat);
    relayout();
    if (selCat == m.cat) selCat = null;
  }
  
  // Deselect
  editingMem = false;
  selMem = null;
  tgtZoom = 1;
}

